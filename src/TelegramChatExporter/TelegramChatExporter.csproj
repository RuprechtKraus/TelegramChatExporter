    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>TelegramChatExporter-90dc5acb-b2b9-4fe1-bb20-a96f687ce193</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WTelegramClient" Version="4.4.9" />
